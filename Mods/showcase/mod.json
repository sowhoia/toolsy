{
  "schema": 1,
  "id": "showcase",
  "name": "Витрина",
  "version": "1.0.0",
  "author": "Toolsy",
  "summary": "Все элементы формата модов на одной странице",
  "icon": "square.grid.2x2.fill",
  "tint": "teal",
  "settings": {
    "amplitude": 60,
    "period": 20,
    "waveShape": "sine",
    "showSecond": true,
    "sortBy": "CPU",
    "greetingName": ""
  },
  "commands": {
    "watch": { "exec": "scripts/service.sh" },
    "refresh": { "exec": "scripts/refresh.sh", "timeout": 10 },
    "greet": { "exec": "scripts/action.sh", "args": ["greet"] },
    "count": { "exec": "scripts/action.sh", "args": ["count"] },
    "reset": { "exec": "scripts/action.sh", "args": ["reset"] },
    "dice": { "exec": "scripts/action.sh", "args": ["dice"] },
    "live-echo": { "exec": "scripts/action.sh", "args": ["live-echo"] },
    "fail": { "exec": "scripts/action.sh", "args": ["fail"] },
    "slow": { "exec": "scripts/action.sh", "args": ["slow"], "timeout": 10 },
    "process-info": { "exec": "scripts/action.sh", "args": ["process-info"] },
    "os-version": { "shell": "sw_vers -productVersion", "capture": "osVersion" }
  },
  "lifecycle": {
    "service": "watch",
    "refresh": { "command": "refresh", "every": 5 }
  },
  "ui": [
    {
      "type": "section",
      "title": "Система сейчас",
      "footer": "Служба присылает эти значения раз в секунду, пока мод включён.",
      "children": [
        { "type": "text", "text": "Включите мод переключателем, чтобы запустить службу.", "style": "caption", "when": "!enabled" },
        {
          "type": "row",
          "when": "enabled",
          "children": [
            { "type": "gauge", "label": "Нагрузка", "icon": "cpu", "bind": "loadPercent", "unit": "%", "style": "ring", "tint": "{{loadLevel}}" },
            { "type": "gauge", "label": "Память", "icon": "memorychip", "bind": "memoryUsed", "unit": "%", "style": "ring", "tint": "purple" }
          ]
        },
        { "type": "value", "label": "Средняя нагрузка", "icon": "speedometer", "value": "{{load1|fixed:2|default:—}} · {{load5|fixed:2|default:—}} · {{load15|fixed:2|default:—}}", "tint": "{{loadLevel}}" },
        { "type": "value", "label": "Доступно памяти", "icon": "square.stack.3d.up", "value": "{{availableBytes|bytes|default:—}} ({{memoryUsed|percent|default:—}} занято)" },
        { "type": "value", "label": "Сеть (en*)", "icon": "arrow.up.arrow.down", "value": "↓ {{rxRate|rate|default:—}}  ↑ {{txRate|rate|default:—}}" },
        { "type": "chart", "label": "Нагрузка за 2 минуты", "series": [ { "bind": "load1", "label": "1 мин", "tint": "orange" } ], "style": "area", "points": 120, "min": 0 }
      ]
    },
    {
      "type": "section",
      "title": "Волна",
      "footer": "Настройки этого раздела сохраняются между запусками. Когда они меняются, Toolsy перезапускает службу.",
      "children": [
        { "type": "chart", "label": "Сигнал", "series": [ { "bind": "wave", "label": "Основная", "tint": "blue" }, { "bind": "wave2", "label": "Вторая", "tint": "pink" } ], "style": "line", "points": 60, "min": -100, "max": 100 },
        { "type": "gauge", "label": "Уровень", "icon": "waveform.path", "bind": "wave", "min": -100, "max": 100, "style": "bar", "tint": "blue" },
        { "type": "value", "label": "Сейчас", "icon": "number", "value": "{{wave|round|default:—}}" },
        {
          "type": "picker", "label": "Форма", "bind": "waveShape", "style": "segmented",
          "options": [
            { "value": "sine", "label": "Синус", "icon": "waveform.path" },
            { "value": "triangle", "label": "Треугольник", "icon": "triangle" },
            { "value": "square", "label": "Меандр", "icon": "square" }
          ]
        },
        { "type": "slider", "label": "Амплитуда", "icon": "arrow.up.and.down", "bind": "amplitude", "min": 10, "max": 100, "step": 5, "unit": "%" },
        { "type": "stepper", "label": "Период", "icon": "timer", "bind": "period", "min": 5, "max": 60, "step": 5, "unit": " с" },
        { "type": "toggle", "label": "Вторая волна", "icon": "square.on.square", "bind": "showSecond" },
        { "type": "text", "text": "Служба остановлена, график не обновляется.", "style": "caption", "tint": "warn", "when": "!enabled" }
      ]
    },
    {
      "type": "section",
      "title": "Процессы",
      "footer": "Обновляется каждые 5 секунд, пока открыта панель. Нажмите на процесс, чтобы узнать о нём больше.",
      "children": [
        { "type": "picker", "label": "Сортировка", "icon": "arrow.up.arrow.down", "bind": "sortBy", "style": "menu", "options": ["CPU", "Память"], "command": "refresh" },
        { "type": "chart", "label": "CPU первых восьми, %", "series": [ { "bind": "topCPU", "tint": "green" } ], "style": "bar", "min": 0 },
        { "type": "list", "bind": "processes", "command": "process-info", "empty": "Список появится после первого обновления", "limit": 8 },
        { "type": "value", "label": "Выбран", "icon": "info.circle", "value": "{{selectedProcess}}", "when": "selectedProcess" },
        { "type": "value", "label": "Всего процессов", "icon": "number", "value": "{{processCount|default:—}}" }
      ]
    },
    {
      "type": "section",
      "title": "Кнопки и ввод",
      "footer": "Кнопка «Ошибка» всегда завершается сбоем, «Долгая операция» длится три секунды.",
      "children": [
        { "type": "input", "label": "Имя", "icon": "person", "bind": "greetingName", "placeholder": "Как вас зовут?", "command": "greet" },
        { "type": "text", "text": "{{greeting|default:Введите имя и нажмите Return.}}" },
        { "type": "divider" },
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "Нажать", "icon": "hand.tap", "command": "count", "value": 1 },
            { "type": "button", "label": "Бросок", "icon": "dice", "command": "dice", "style": "prominent" },
            { "type": "button", "label": "Сбросить", "icon": "arrow.counterclockwise", "command": "reset", "style": "destructive", "confirm": "Сбросить счётчик нажатий?", "disabled": "!clicks" }
          ]
        },
        {
          "type": "row",
          "children": [
            { "type": "value", "label": "Нажатий", "value": "{{clicks|default:0}}" },
            { "type": "value", "label": "Кубик", "value": "{{dice|default:—}}", "tint": "blue" }
          ]
        },
        { "type": "divider" },
        { "type": "slider", "label": "Живой ползунок", "icon": "slider.horizontal.3", "bind": "liveLevel", "min": 0, "max": 100, "step": 1, "command": "live-echo", "live": true },
        { "type": "text", "text": "{{liveEcho|default:Двигайте ползунок: команда запускается прямо во время движения.}}", "style": "caption" },
        { "type": "divider" },
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "Долгая операция", "icon": "hourglass", "command": "slow" },
            { "type": "button", "label": "Ошибка", "icon": "exclamationmark.triangle", "command": "fail" }
          ]
        },
        { "type": "value", "label": "Долгая операция", "icon": "checkmark.circle", "value": "{{slowResult}}", "tint": "ok", "when": "slowResult" },
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "Версия macOS", "icon": "apple.logo", "command": "os-version" },
            { "type": "button", "label": "SF Symbols", "icon": "safari", "open": "https://developer.apple.com/sf-symbols/" }
          ]
        },
        { "type": "value", "label": "macOS", "icon": "desktopcomputer", "value": "{{osVersion}}", "when": "osVersion" }
      ]
    },
    {
      "type": "section",
      "title": "Текст и значения",
      "footer": "Нажмите на имя компьютера, чтобы скопировать его.",
      "children": [
        { "type": "text", "text": "{{hostname|default:Этот Mac}}", "style": "title" },
        { "type": "text", "text": "Обычный текст страницы мода. Шаблоны подставляют значения состояния и форматируют их фильтрами.", "style": "body" },
        { "type": "text", "text": "Подпись: второстепенная информация мелким шрифтом.", "style": "caption" },
        { "type": "text", "text": "uptime {{uptime|duration|default:—}} · load {{load1|fixed:2|default:—}}", "style": "mono" },
        { "type": "value", "label": "Имя компьютера", "icon": "laptopcomputer", "value": "{{hostname|default:—}}", "copyable": true },
        { "type": "value", "label": "Работает без перезагрузки", "icon": "clock", "value": "{{uptime|duration|default:—}}" }
      ]
    }
  ]
}
