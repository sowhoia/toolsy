{
  "schema": 1,
  "id": "showcase",
  "name": "Showcase",
  "version": "2.0.0",
  "author": "Toolsy",
  "summary": "Every part of the mod format on one page",
  "icon": "square.grid.2x2.fill",
  "tint": "teal",
  "settings": {
    "amplitude": 60,
    "period": 20,
    "waveShape": "sine",
    "showSecond": true,
    "order": "CPU",
    "greetingName": ""
  },
  "commands": {
    "on": { "shell": "printf '{\"onSince\": %s}\\n' \"$(date +%s)\"" },
    "off": { "shell": "echo '{\"onSince\": null}'" },
    "watch": { "exec": "scripts/service.sh" },
    "refresh": { "exec": "scripts/refresh.sh", "timeout": 10 },
    "event": { "exec": "scripts/action.sh", "args": ["event"] },
    "greet": { "exec": "scripts/action.sh", "args": ["greet"] },
    "count": { "exec": "scripts/action.sh", "args": ["count"] },
    "reset": { "exec": "scripts/action.sh", "args": ["reset"] },
    "dice": { "exec": "scripts/action.sh", "args": ["dice"] },
    "live-echo": { "exec": "scripts/action.sh", "args": ["live-echo"] },
    "fail": { "exec": "scripts/action.sh", "args": ["fail"] },
    "slow": { "exec": "scripts/action.sh", "args": ["slow"], "timeout": 10 },
    "process-info": { "exec": "scripts/action.sh", "args": ["process-info"] },
    "interface-info": { "exec": "scripts/action.sh", "args": ["interface-info"] },
    "notify": { "exec": "scripts/action.sh", "args": ["notify"] },
    "os-version": { "shell": "sw_vers -productVersion", "capture": "osVersion" },
    "input": { "shell": "jq -c '{inputKeys: (.state | length), inputEvent: .event, inputLocale: (.locale // \"none\")}'", "stdin": true }
  },
  "lifecycle": {
    "enable": "on",
    "disable": "off",
    "service": "watch",
    "refresh": { "command": "refresh", "every": 5 },
    "events": { "launch": "event", "wake": "event", "network": "event", "power": "event" }
  },
  "ui": [
    {
      "type": "section",
      "title": "System now",
      "footer": "The service sends these values every second while the mod is on.",
      "children": [
        { "type": "text", "text": "Switch the mod on to start its service.", "style": "caption", "when": "!enabled" },
        {
          "type": "row",
          "when": "enabled",
          "children": [
            { "type": "gauge", "label": "Load", "icon": "cpu", "bind": "loadPercent", "unit": "%", "style": "ring", "tint": "{{loadLevel}}" },
            { "type": "gauge", "label": "Memory", "icon": "memorychip", "bind": "memoryUsed", "format": "percent", "style": "ring", "tint": "purple" }
          ]
        },
        {
          "type": "row",
          "when": "enabled",
          "children": [
            { "type": "stat", "label": "On since", "icon": "power", "value": "{{onSince|time|default:—}}" },
            { "type": "stat", "label": "Load", "icon": "speedometer", "value": "{{load1|fixed:2|default:—}}", "tint": "{{loadLevel}}" },
            { "type": "stat", "label": "Available", "icon": "square.stack.3d.up", "value": "{{availableBytes|bytes|default:—}}" }
          ]
        },
        { "type": "value", "label": "Load average", "icon": "speedometer", "value": "{{load1|fixed:2|default:—}} · {{load5|fixed:2|default:—}} · {{load15|fixed:2|default:—}}", "tint": "{{loadLevel}}", "help": "Over 1, 5 and 15 minutes" },
        { "type": "value", "label": "Available memory", "icon": "square.stack.3d.up", "value": "{{availableBytes|bytes|default:—}} ({{memoryUsed|percent|default:—}} used)" },
        { "type": "text", "text": "Memory is running low.", "style": "caption", "tint": "warn", "when": "enabled && (availableBytes / 1000000000 < 2 || memoryUsed > 90)" },
        { "type": "value", "label": "Network (en*)", "icon": "arrow.up.arrow.down", "value": "↓ {{rxRate|rate|default:—}}  ↑ {{txRate|rate|default:—}}" },
        { "type": "value", "label": "In bits", "icon": "arrow.up.arrow.down", "value": "↓ {{rxRate|bitrate|default:—}}  ↑ {{txRate|bitrate|default:—}}" },
        { "type": "chart", "label": "Load over 2 minutes", "series": [ { "bind": "load1", "label": "1 min", "tint": "orange" } ], "style": "area", "points": 120, "min": 0 },
        { "type": "chart", "label": "Network", "series": [ { "bind": "rxRate", "label": "In", "tint": "blue" }, { "bind": "txRate", "label": "Out", "tint": "green" } ], "style": "line", "min": 0, "format": "rate" }
      ]
    },
    {
      "type": "section",
      "title": "Wave",
      "footer": "The settings of this section are kept between launches. When they change, Toolsy restarts the service.",
      "children": [
        { "type": "chart", "label": "Signal", "series": [ { "bind": "wave", "label": "Main", "tint": "blue" }, { "bind": "wave2", "label": "Second", "tint": "pink" } ], "style": "line", "points": 60, "min": -100, "max": 100 },
        { "type": "gauge", "label": "Level", "icon": "waveform.path", "bind": "wave", "min": -100, "max": 100, "style": "bar", "tint": "blue" },
        { "type": "value", "label": "Now", "icon": "number", "value": "{{wave|round|default:—}}" },
        {
          "type": "picker", "label": "Shape", "bind": "waveShape", "style": "segmented",
          "options": [
            { "value": "sine", "label": "Sine", "icon": "waveform.path" },
            { "value": "triangle", "label": "Triangle", "icon": "triangle" },
            { "value": "square", "label": "Square", "icon": "square" }
          ]
        },
        { "type": "slider", "label": "Amplitude", "icon": "arrow.up.and.down", "bind": "amplitude", "min": 10, "max": 100, "step": 5, "unit": "%" },
        { "type": "stepper", "label": "Period", "icon": "timer", "bind": "period", "min": 5, "max": 60, "step": 5, "unit": " s" },
        { "type": "toggle", "label": "Second wave", "icon": "square.on.square", "bind": "showSecond" },
        { "type": "text", "text": "The service is stopped, so the chart does not move.", "style": "caption", "tint": "warn", "when": "!enabled" }
      ]
    },
    {
      "type": "section",
      "title": "Processes",
      "footer": "Updated every 5 seconds while the panel is open. Click a process to learn more about it.",
      "children": [
        {
          "type": "picker", "label": "Sort by", "icon": "arrow.up.arrow.down", "bind": "order", "style": "menu", "command": "refresh",
          "options": [ "CPU", "Memory" ]
        },
        { "type": "chart", "label": "CPU of the top eight, %", "series": [ { "bind": "topCPU", "tint": "green" } ], "style": "bar", "min": 0, "unit": "%" },
        { "type": "list", "bind": "processes", "command": "process-info", "empty": "The list appears after the first refresh", "limit": 8 },
        { "type": "value", "label": "Selected", "icon": "info.circle", "value": "{{selectedProcess}}", "when": "selectedProcess" },
        { "type": "value", "label": "Busiest", "icon": "flame", "value": "{{processes.0.title|default:—}}", "help": "The first row of the list, read with a template path" },
        { "type": "value", "label": "All processes", "icon": "number", "value": "{{processCount|number|default:—}}" }
      ]
    },
    {
      "type": "section",
      "title": "Buttons and input",
      "footer": "“Fail” always fails, “Slow” takes three seconds.",
      "children": [
        { "type": "input", "label": "Name", "icon": "person", "bind": "greetingName", "placeholder": "What is your name?", "command": "greet" },
        { "type": "text", "text": "{{greeting|default:Type a name and press Return.}}" },
        { "type": "text", "text": "That is this app's name too.", "style": "caption", "when": "greetingName contains 'Toolsy'" },
        { "type": "divider" },
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "Press", "icon": "hand.tap", "command": "count", "value": 1 },
            { "type": "button", "label": "Roll", "icon": "dice", "command": "dice", "style": "prominent" },
            { "type": "button", "label": "Reset", "icon": "arrow.counterclockwise", "command": "reset", "style": "destructive", "confirm": "Reset the press counter?", "disabled": "!clicks" }
          ]
        },
        {
          "type": "row",
          "children": [
            { "type": "stat", "label": "Presses", "value": "{{clicks|default:0}}" },
            { "type": "stat", "label": "Die", "value": "{{dice|default:—}}", "tint": "blue" }
          ]
        },
        { "type": "text", "text": "A multiple of ten!", "style": "caption", "tint": "ok", "when": "clicks > 0 && clicks % 10 == 0" },
        { "type": "divider" },
        { "type": "slider", "label": "Live slider", "icon": "slider.horizontal.3", "bind": "liveLevel", "min": 0, "max": 100, "step": 1, "command": "live-echo", "live": true },
        { "type": "text", "text": "{{liveEcho|default:Move the slider: its command runs while you drag.}}", "style": "caption" },
        { "type": "divider" },
        { "type": "picker", "label": "Interface", "icon": "network", "bind": "interface", "optionsFrom": "interfaces", "style": "menu", "command": "interface-info", "help": "The options come from the refresh command" },
        { "type": "value", "label": "Traffic", "icon": "arrow.up.arrow.down", "value": "↓ {{interfaceIn|bytes}}  ↑ {{interfaceOut|bytes}}", "when": "interface && interfaceIn != null" },
        { "type": "divider" },
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "Slow", "icon": "hourglass", "command": "slow" },
            { "type": "button", "label": "Fail", "icon": "exclamationmark.triangle", "command": "fail" }
          ]
        },
        { "type": "value", "label": "Slow", "icon": "checkmark.circle", "value": "{{slowResult}}", "tint": "ok", "when": "slowResult" },
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "macOS version", "icon": "apple.logo", "command": "os-version" },
            { "type": "button", "label": "Command input", "icon": "curlybraces", "command": "input" },
            { "type": "button", "label": "SF Symbols", "icon": "safari", "open": "https://developer.apple.com/sf-symbols/" }
          ]
        },
        { "type": "value", "label": "macOS", "icon": "desktopcomputer", "value": "{{osVersion}}", "when": "osVersion" },
        { "type": "value", "label": "Command input", "icon": "curlybraces", "value": "{{inputKeys}} state keys · event {{inputEvent}} · language {{inputLocale}}", "when": "inputKeys" }
      ]
    },
    {
      "type": "section",
      "title": "Events and notifications",
      "footer": "While the mod is on, it counts what happens to the Mac: Toolsy starting, waking from sleep, network and power changes.",
      "children": [
        {
          "type": "row",
          "children": [
            { "type": "stat", "label": "Last event", "icon": "bolt", "value": "{{lastEvent|default:None yet}}" },
            { "type": "stat", "label": "When", "icon": "clock", "value": "{{lastEventAt|ago|default:—}}" },
            { "type": "stat", "label": "Events", "icon": "number", "value": "{{eventCount|default:0}}" }
          ]
        },
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "Notify", "icon": "bell", "command": "notify", "value": "text" },
            { "type": "button", "label": "Notify with a title", "icon": "bell.badge", "command": "notify", "value": "titled" }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Text and values",
      "footer": "Click the computer's name to copy it.",
      "children": [
        { "type": "text", "text": "{{hostname|default:This Mac}}", "style": "title" },
        { "type": "text", "text": "Body text of a mod page. Templates insert values of the state and format them with filters.", "style": "body" },
        { "type": "text", "text": "A caption: secondary information in a small font.", "style": "caption" },
        { "type": "text", "text": "uptime {{uptime|duration|default:—}} · load {{load1|fixed:2|default:—}}", "style": "mono" },
        { "type": "value", "label": "Computer name", "icon": "laptopcomputer", "value": "{{hostname|default:—}}", "copyable": true },
        { "type": "value", "label": "Up for", "icon": "clock", "value": "{{uptime|duration|default:—}}" },
        { "type": "button", "label": "Copy a summary", "icon": "doc.on.doc", "copy": "{{hostname}}: up for {{uptime|duration}}, {{processCount}} processes", "disabled": "!hostname" }
      ]
    },
    {
      "type": "section",
      "title": "Template filters",
      "footer": "Each line passes a value of the state through filters.",
      "collapsible": true,
      "collapsed": true,
      "children": [
        { "type": "value", "label": "Booted", "value": "{{bootTime|date|default:—}} {{bootTime|time|default:—}}, {{bootTime|ago|default:—}}" },
        { "type": "value", "label": "Up for, in hours", "value": "{{uptime|div:3600|fixed:1|default:—}}" },
        { "type": "value", "label": "Load × 100 + 1", "value": "{{load1|mul:100|add:1|round|default:—}}" },
        { "type": "value", "label": "Available, in bytes", "value": "{{availableBytes|number|default:—}}" },
        { "type": "value", "label": "Name in capitals", "value": "{{hostname|upper|default:—}}" },
        { "type": "value", "label": "Name in lowercase, cut", "value": "{{hostname|lower|truncate:10|default:—}}" },
        { "type": "value", "label": "Characters in the name", "value": "{{hostname|count|default:—}}" },
        { "type": "value", "label": "CPU of the top eight", "value": "{{topCPU|join: · |default:—}}" },
        { "type": "value", "label": "Interfaces", "value": "{{interfaces|count|default:0}}: {{interfaces|join}}" },
        { "type": "value", "label": "Service", "value": "{{enabled|either:running:stopped}}", "tint": "{{enabled|either:ok:off}}" }
      ]
    }
  ],
  "widgets": [
    {
      "id": "load", "title": "Load", "icon": "cpu", "value": "{{load1|fixed:2|default:—}}", "tint": "{{loadLevel|default:off}}",
      "chart": { "series": [ { "bind": "load1" } ], "style": "area", "points": 60, "min": 0 },
      "when": "enabled"
    },
    {
      "id": "memory", "title": "Memory", "icon": "memorychip", "value": "{{memoryUsed|percent|default:—}}", "tint": "purple",
      "gauge": { "bind": "memoryUsed" },
      "when": "enabled"
    },
    {
      "id": "clicks", "title": "Presses", "icon": "hand.tap", "value": "{{clicks|number|default:0}}", "size": "medium",
      "detail": [
        {
          "type": "row",
          "children": [
            { "type": "button", "label": "Press", "icon": "hand.tap", "command": "count", "value": 1, "style": "prominent" },
            { "type": "button", "label": "Reset", "icon": "arrow.counterclockwise", "command": "reset", "confirm": "Reset the press counter?", "disabled": "!clicks" }
          ]
        },
        { "type": "button", "label": "Notify with a title", "icon": "bell.badge", "command": "notify", "value": "titled" }
      ]
    },
    {
      "id": "wave", "title": "Wave", "icon": "waveform.path", "value": "{{wave|round|default:—}}", "size": "wide",
      "chart": { "series": [ { "bind": "wave", "label": "Main", "tint": "blue" }, { "bind": "wave2", "label": "Second", "tint": "pink" } ], "style": "line", "points": 60, "min": -100, "max": 100 },
      "detail": [
        {
          "type": "picker", "label": "Shape", "bind": "waveShape",
          "options": [ { "value": "sine", "label": "Sine" }, { "value": "triangle", "label": "Triangle" }, { "value": "square", "label": "Square" } ]
        },
        { "type": "slider", "label": "Amplitude", "bind": "amplitude", "min": 10, "max": 100, "step": 5, "unit": "%" },
        { "type": "toggle", "label": "Second wave", "bind": "showSecond" },
        { "type": "text", "text": "Switch the mod on to start the wave.", "style": "caption", "when": "!enabled" }
      ]
    }
  ],
  "localizations": {
    "ru": {
      "Showcase": "Витрина",
