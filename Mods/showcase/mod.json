      "Switch the mod on to start its service.": "Включите мод переключателем, чтобы запустить службу.",
      "Load": "Нагрузка",
      "Memory": "Память",
      "On since": "Включён с",
      "Available": "Доступно",
      "Load average": "Средняя нагрузка",
      "Over 1, 5 and 15 minutes": "За 1, 5 и 15 минут",
      "Available memory": "Доступно памяти",
      "{{availableBytes|bytes|default:—}} ({{memoryUsed|percent|default:—}} used)": "{{availableBytes|bytes|default:—}} ({{memoryUsed|percent|default:—}} занято)",
