      "{{hostname}}: up for {{uptime|duration}}, {{processCount}} processes": "{{hostname}}: работает {{uptime|duration}}, процессов: {{processCount}}",
      "Template filters": "Фильтры шаблонов",
      "Each line passes a value of the state through filters.": "Каждая строка пропускает значение состояния через фильтры.",
      "Booted": "Загружен",
      "Up for, in hours": "Работает, часов",
      "Load × 100 + 1": "Нагрузка × 100 + 1",
      "Available, in bytes": "Доступно, байт",
      "Name in capitals": "Имя заглавными",
      "Name in lowercase, cut": "Имя строчными, обрезанное",
      "Characters in the name": "Символов в имени",
      "CPU of the top eight": "CPU первых восьми",
      "Interfaces": "Интерфейсы",
      "Service": "Служба",
      "{{enabled|either:running:stopped}}": "{{enabled|either:работает:остановлена}}",
      "Switch the mod on to start the wave.": "Включите мод, чтобы запустить волну."
    }
  }
}
