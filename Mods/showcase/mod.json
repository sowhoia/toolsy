      "Press": "Нажать",
      "Roll": "Бросить",
      "Reset": "Сбросить",
      "Reset the press counter?": "Сбросить счётчик нажатий?",
      "Presses": "Нажатий",
      "Die": "Кубик",
      "A multiple of ten!": "Круглое число!",
      "Live slider": "Живой ползунок",
      "{{liveEcho|default:Move the slider: its command runs while you drag.}}": "{{liveEcho|default:Двигайте ползунок: команда запускается прямо во время движения.}}",
      "Interface": "Интерфейс",
